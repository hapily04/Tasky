# SQLite at data/tasky.db (created automatically by npm run dev / panel-start)
# Local dev:
DATABASE_URL="file:../data/tasky.db"

# Pterodactyl: panel-start.mjs sets this automatically; optional in /home/container/.env:
# DATABASE_URL="file:/home/container/data/tasky.db"

# Server — set PORT to your panel's assigned port (not 3000 on most panels)
PORT=3000
# Bind address (0.0.0.0 = reachable from the panel). Do not use HOSTNAME — the OS owns that.
BIND_HOST=0.0.0.0

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Discord OAuth (https://discord.com/developers/applications)
# Application name: Tasky
# Redirect URI: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Comma-separated Discord user IDs granted ADMIN on login
ADMIN_DISCORD_IDS=""
